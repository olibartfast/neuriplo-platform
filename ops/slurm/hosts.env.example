# Example operator inventory. Copy to operator-inventory/hosts.env
# (untracked, never commit) and fill in real values. This file carries
# placeholders only and must never contain real addresses or hostnames.
# Profiles: docs/architecture/heterogeneous-placement.md

# P-LNX-NVIDIA: Linux x86_64 + NVIDIA GPU (TensorRT lane)
P_LNX_NVIDIA_HOST=
P_LNX_NVIDIA_ADDR=
P_LNX_NVIDIA_CPUS=12
P_LNX_NVIDIA_GRES=gpu:rtx3060:1
P_LNX_NVIDIA_FEATURES=arch_x86_64,backend_tensorrt,backend_ort_cuda,backend_libtorch_cuda,cuda_86

# P-LNX-CPU: Linux x86_64 CPU/Intel (OpenVINO lane)
P_LNX_CPU_HOST=
P_LNX_CPU_ADDR=
P_LNX_CPU_CPUS=4
P_LNX_CPU_GRES=
P_LNX_CPU_FEATURES=arch_x86_64,backend_openvino,backend_ort_cpu,backend_nert,cpu_only

# P-LNX-EDGE-CPU: Linux x86_64 edge laptop (ORT/LibTorch/LiteRT/ExecuTorch CPU)
P_LNX_EDGE_CPU_HOST=
P_LNX_EDGE_CPU_ADDR=
P_LNX_EDGE_CPU_CPUS=4
P_LNX_EDGE_CPU_GRES=
P_LNX_EDGE_CPU_FEATURES=arch_x86_64,backend_ort_cpu,backend_libtorch_cpu,backend_litert,backend_executorch,cpu_only

# P-LNX-ARM-EDGE: Linux aarch64 edge (TensorRT Jetson-class + edge CPU backends)
P_LNX_ARM_EDGE_HOST=
P_LNX_ARM_EDGE_ADDR=
P_LNX_ARM_EDGE_CPUS=4
P_LNX_ARM_EDGE_GRES=
P_LNX_ARM_EDGE_FEATURES=arch_aarch64,backend_tensorrt_jetson,backend_litert,backend_executorch,edge

# P-WIN-CPU: Windows x64 (OpenCV 5 + ORT via native runner, NO slurmd)
P_WIN_CPU_HOST=
P_WIN_CPU_ADDR=
P_WIN_CPU_SCHED=native-runner

# P-CLD-AMD: cloud x86_64 + AMD GPU ROCm (MIGraphX, ONNX only)
P_CLD_AMD_HOST=
P_CLD_AMD_ADDR=
P_CLD_AMD_CPUS=8
P_CLD_AMD_GRES=gpu:amd:1
P_CLD_AMD_FEATURES=arch_x86_64,backend_migraphx,rocm,amd,cloud

# P-CLD-BURST: ephemeral cloud NVIDIA (ORT/LibTorch/NERT)
P_CLD_BURST_HOST=
P_CLD_BURST_ADDR=
P_CLD_BURST_CPUS=4
P_CLD_BURST_GRES=gpu:1
P_CLD_BURST_FEATURES=arch_x86_64,burst,ephemeral,cloud
